# Python Discovery Service Configuration

# Service Settings
SERVICE_NAME=network-discovery-service
SERVICE_VERSION=1.0.0
DEBUG=true

# Database Configuration (matches Laravel .env)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=network_monitoring
DB_USERNAME=laravel_user
DB_PASSWORD=laravel_password

# Service Port
SERVICE_PORT=8000

# SNMP Configuration (matches Laravel config/snmp.php)
SNMP_COMMUNITY=public
SNMP_VERSION=v2c
SNMP_TIMEOUT=5
SNMP_RETRIES=3
SNMP_PORT=161

# ICMP Configuration (Step 3)
ICMP_COUNT=1
ICMP_TIMEOUT=5.0
ICMP_INTERVAL=0.5
ICMP_PRIVILEGED=true
